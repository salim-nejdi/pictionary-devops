# =============================================================================
# .env.example — Modèle de configuration pour le développement local
#
# CE FICHIER EST VERSIONNÉ SUR GITHUB 
#
# Pour démarrer l'application en local :
#   1. Copie ce fichier : cp .env.example .env
#   2. Remplis les valeurs dans .env
#   3. Lance : docker compose up --build
#
# =============================================================================

# Mot de passe root MariaDB (utilisé par le healthcheck)
MYSQL_ROOT_PASSWORD=

# Nom de la base de données
MYSQL_DATABASE=pictionary

# Utilisateur applicatif (utilisé par PHP pour se connecter)
MYSQL_USER=

# Mot de passe de l'utilisateur applicatif
MYSQL_PASSWORD=
